{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n front,back -c cyan,yellow \"pnpm dev\" \"pnpm dev:backend\"",
    "dev:backend": "pnpm --filter @rpg-master/backend dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @rpg-master/backend test",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
